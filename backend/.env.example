# 后端环境变量示例（复制为 .env 或直接使用环境变量覆盖）
# 数据库：默认 SQLite 开箱即用；生产建议切换到 MySQL
#DATABASE_URL=sqlite:///./etl_saas.db
# DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/etl_saas?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:72816e2442952a42@139.155.68.150:3306/etl_saas?charset=utf8mb4


# JWT
SECRET_KEY=change-this-secret-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据源密码加密（留空则基于 SECRET_KEY 派生）
FERNET_KEY=

# 默认管理员（首次启动自动创建）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=admin123

# 免费版额度
FREE_MAX_DATASOURCES=3
FREE_MAX_TASKS=5

# 同步引擎
SYNC_BATCH_SIZE=5000
SYNC_TASK_TIMEOUT=3600

# 调度器
SCHEDULER_TIMEZONE=Asia/Shanghai
